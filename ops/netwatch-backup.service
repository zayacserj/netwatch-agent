[Unit]
Description=Create and verify NetWatch backups

[Service]
Type=oneshot
User=root
UMask=0077
Environment=NETWATCH_BACKUP_KEEP_DAYS=30
EnvironmentFile=-/etc/netwatch-backup.conf
ExecStart=/usr/bin/python3 -IB /usr/local/lib/netwatch/backup_netwatch.py create
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
